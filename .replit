# Replit 설정 — [Run] 한 번이면 된다. 자세한 것은 docs/REPLIT_DEPLOYMENT.md
#
# · 갈래는 online/start.mjs 가 고른다: 데이터베이스(DATABASE_URL)가 없으면 개인판(호스팅 꼴),
#   있으면 온라인판(로그인 · PostgreSQL · AI 작업). 온라인판 의존성 설치(npm ci)도 스스로 한다.
#
# · 포트 — Replit 이 PORT 를 주면 그것을, 없으면 5000(Replit 미리보기가 기다리는 포트 — tools/hosting.mjs REPLIT_PORT).
#   서버가 연 그 포트가 아래 [[ports]] 로 외부 80 에 붙는다.
#   실행 명령에는 포트를 박지 않는다.
# · 주소 — 0.0.0.0. 온라인판은 계정(아이디 · 비밀번호)이 문을 지킨다 — 출입 열쇠를 쓰지 않는다.
#   처음 설정(계정이 없을 때)은 Console 에 찍힌 설정 코드를 넣어야 한다.
#   개인판 갈래(데이터베이스 없음)만 출입 열쇠 SE2_ACCESS_KEY(16자 이상, Secrets)가 있어야 선다.
# · AI — 온라인판은 처음 설정 화면에서 넣은 키로 돈다(서버에 봉해 저장). 개인판 갈래는 SE2_MOCK=1 로 모의 응답.
# · 저장 — 온라인판은 PostgreSQL. 개인판 갈래의 data/ JSON 은 다시 게시하면 사라질 수 있다(시험 데이터만).
# · 게시 — Publishing → Reserved VM → Web server. Autoscale 은 쓰지 않는다
#   (잠들거나 여러 벌로 늘면 «메모리가 정본»인 지금 판의 상태가 갈린다).

modules = ["nodejs-22"]
entrypoint = "online/start.mjs"
run = ["sh", "-c", "SE2_HOST=0.0.0.0 node online/start.mjs"]

[nix]
channel = "stable-24_11"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "gce"
run = ["sh", "-c", "SE2_HOST=0.0.0.0 node online/start.mjs"]
